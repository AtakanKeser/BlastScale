# Copy to .env (or .env.local) for local development. Values are inlined at build time by Vite.

# Base URL of the BlastScale API (nginx in docker-compose, or the Spring Boot app directly).
VITE_API_BASE_URL=http://localhost:8080

# Prometheus HTTP API, queried directly by the dashboard for request rate / latency / error rate.
VITE_PROMETHEUS_URL=http://localhost:9090
