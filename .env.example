# Copy this file to .env and adjust the values. docker-compose reads it automatically.
# Never commit the real .env file.

# JWT signing secret (HMAC-SHA256). Must be at least 32 bytes. Generate one with: openssl rand -base64 48
BLASTSCALE_JWT_SECRET=change-me-please-this-is-only-a-local-development-secret-0123456789

# Admin bootstrap account (created on first start if it does not exist)
BLASTSCALE_ADMIN_USERNAME=admin
BLASTSCALE_ADMIN_PASSWORD=admin12345

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=blastscale
MYSQL_USER=blastscale
MYSQL_PASSWORD=blastscale

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
